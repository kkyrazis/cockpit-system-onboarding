{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cockpit-project.org/schemas/system-onboarding-config-v1.json",
  "title": "Cockpit System Onboarding Configuration",
  "description": "Configuration file schema for the Cockpit System Onboarding plugin",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Configuration schema version (must be '1.0')"
    },
    "runOnce": {
      "type": "boolean",
      "default": true,
      "description": "Disable the plugin and remove onboarding user after successful completion"
    },
    "keepCockpit": {
      "type": "boolean",
      "default": false,
      "description": "Keep Cockpit web console enabled after onboarding completion"
    },
    "hideModules": {
      "type": "boolean",
      "default": true,
      "description": "Hide other Cockpit modules during onboarding (show only System Onboarding)"
    },
    "autoReboot": {
      "type": "boolean",
      "default": false,
      "description": "Automatically reboot the system after applying configuration changes"
    },
    "brandName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Product name shown in the onboarding plugin UI. Set at build time via the BRAND_NAME environment variable."
    },
    "network": {
      "type": "object",
      "description": "Network interface configuration for initial system access",
      "properties": {
        "activationTimeoutSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "description": "Seconds to wait for a NetworkManager connection to activate before timing out"
        },
        "wifiAp": {
          "type": "object",
          "description": "WiFi access point configuration for initial wireless access",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Enable temporary WiFi access point on first boot"
            },
            "ssidPrefix": {
              "type": "string",
              "default": "flightctl-",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[a-zA-Z0-9_-]+$",
              "description": "SSID prefix (full SSID will be <prefix><hostname>-<random>)"
            },
            "interface": {
              "type": "string",
              "description": "WiFi interface name (e.g., 'wlan0'). If not specified, first available WiFi interface will be used."
            },
            "password": {
              "type": "string",
              "maxLength": 63,
              "default": "onboarding",
              "description": "WPA passphrase for the access point (8-63 characters). Empty string means open network (no password)."
            },
            "address": {
              "type": "string",
              "format": "ipv4",
              "default": "10.42.0.1",
              "description": "Gateway IP address for the WiFi access point network"
            },
            "subnetPrefix": {
              "type": "integer",
              "default": 24,
              "minimum": 1,
              "maximum": 30,
              "description": "CIDR subnet prefix for the WiFi AP network"
            },
            "dhcpRangeSize": {
              "type": "integer",
              "default": 40,
              "minimum": 1,
              "description": "Number of DHCP addresses in the pool (range starts at base address + 9)"
            },
            "channel": {
              "type": "integer",
              "default": 6,
              "minimum": 1,
              "maximum": 14,
              "description": "WiFi channel for the access point"
            },
            "dhcpLeaseDuration": {
              "type": "string",
              "default": "1h",
              "pattern": "^\\d+[smhd]$",
              "description": "DHCP lease duration for WiFi AP clients (e.g. '1h', '30m', '3600s')"
            },
            "watchdogTimeoutSeconds": {
              "type": "integer",
              "default": 240,
              "minimum": 60,
              "maximum": 1800,
              "description": "Seconds before the network watchdog rolls back WiFi configuration if connectivity fails"
            },
            "driver": {
              "type": "string",
              "default": "nl80211",
              "minLength": 1,
              "description": "Hostapd driver for the WiFi interface (e.g. 'nl80211', 'rtl871xdrv')"
            },
            "hwMode": {
              "type": "string",
              "default": "g",
              "enum": ["a", "b", "g", "ad"],
              "description": "802.11 hardware mode: 'g' for 2.4 GHz, 'a' for 5 GHz, 'b' for legacy 2.4 GHz, 'ad' for 60 GHz"
            },
            "scanWaitMs": {
              "type": "integer",
              "default": 3000,
              "minimum": 1,
              "description": "Milliseconds to wait after triggering a WiFi scan before reading results"
            }
          }
        },
        "ethernet": {
          "type": "object",
          "description": "Ethernet interface configuration for wired access",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Configure Ethernet interface with well-known static IP on first boot"
            },
            "interface": {
              "type": "string",
              "description": "Ethernet interface name (e.g., 'eth0', 'eno1'). If not specified, first available Ethernet interface will be used."
            },
            "staticIp": {
              "type": "string",
              "format": "ipv4",
              "default": "192.168.100.1",
              "description": "Well-known static IPv4 address for initial access"
            },
            "subnetPrefix": {
              "type": "integer",
              "default": 24,
              "minimum": 1,
              "maximum": 30,
              "description": "CIDR subnet prefix for the static IP configuration"
            },
            "dhcpRangeSize": {
              "type": "integer",
              "default": 40,
              "minimum": 1,
              "description": "Number of DHCP addresses in the pool (range starts at base IP + 9)"
            },
            "dhcpLeaseDuration": {
              "type": "string",
              "default": "1h",
              "pattern": "^\\d+[smhd]$",
              "description": "DHCP lease duration for Ethernet onboarding clients (e.g. '1h', '30m', '3600s')"
            },
            "watchdogTimeoutSeconds": {
              "type": "integer",
              "default": 600,
              "minimum": 60,
              "maximum": 1800,
              "description": "Seconds before the network watchdog rolls back Ethernet configuration if connectivity fails"
            }
          }
        }
      }
    },
    "flightctl": {
      "type": "object",
      "description": "Flight Control enrollment service configuration",
      "properties": {
        "defaultEndpoint": {
          "type": "string",
          "description": "Default Flight Control server endpoint URL. Pre-populates the enrollment endpoint field in the wizard.",
          "pattern": "^(https?://.*)?$"
        },
        "certificateExpiration": {
          "type": "string",
          "default": "365d",
          "pattern": "^\\d+[dhm]$",
          "description": "Enrollment certificate expiration duration (e.g. '365d', '24h', '60m')"
        }
      }
    },
    "connectivityTest": {
      "type": "object",
      "description": "Connectivity verification configuration",
      "properties": {
        "host": {
          "type": "string",
          "default": "cockpit-project.org",
          "description": "Default host for network connectivity test (DNS + ping). Overridden by the enrollment endpoint hostname when enrollment is selected."
        },
        "connectivityTimeoutSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 1,
          "description": "Total time budget in seconds for the connectivity loop (carrier detection, DHCP/SLAAC, and reachability check)"
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "Block enrollment until connectivity check passes"
        },
        "ntpSyncTimeoutSeconds": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "description": "Seconds to wait for NTP clock synchronization before proceeding"
        },
        "pingTimeoutSeconds": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Overall timeout in seconds for each ping connectivity check"
        },
        "pingWaitSeconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "description": "Seconds to wait for a single ping reply (-W flag)"
        }
      }
    },
    "defaults": {
      "type": "object",
      "description": "Default values to pre-populate wizard form fields",
      "properties": {
        "hostname": {
          "type": "string",
          "description": "Default hostname (used when system hostname is localhost)"
        },
        "proxy": {
          "type": "object",
          "description": "Default proxy settings",
          "properties": {
            "enabled": { "type": "boolean" },
            "protocol": { "type": "string", "enum": ["http", "https", "socks5"] },
            "applyForHttps": { "type": "boolean" },
            "hostname": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "noProxy": { "type": "string" }
          }
        },
        "labels": {
          "type": "object",
          "description": "Default device labels",
          "properties": {
            "deviceLabels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": { "type": "string" },
                  "value": { "type": "string" }
                },
                "required": ["key", "value"]
              }
            },
            "systemInfoMappings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": { "type": "string" },
                  "value": { "type": "string" }
                },
                "required": ["key", "value"]
              }
            }
          }
        },
        "alias": {
          "type": "object",
          "description": "Default alias configuration",
          "properties": {
            "mode": { "type": "string", "enum": ["hostname", "custom", "none"] },
            "customValue": { "type": "string" }
          }
        },
        "ntp": {
          "type": "object",
          "description": "Default NTP settings to pre-populate the wizard",
          "properties": {
            "autoConfig": {
              "type": "boolean",
              "description": "Pre-select automatic NTP configuration mode"
            },
            "servers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Default NTP server list to pre-populate when system has no configured servers"
            }
          }
        },
        "networkAddress": {
          "type": "object",
          "description": "Default network address settings to pre-populate the wizard",
          "properties": {
            "ipv4": {
              "type": "object",
              "description": "Default IPv4 address settings",
              "properties": {
                "method": { "type": "string", "enum": ["auto", "static", "disabled"] },
                "address": { "type": "string", "format": "ipv4" },
                "subnetMask": { "type": "string", "format": "ipv4" },
                "gateway": { "type": "string", "format": "ipv4" },
                "primaryDns": { "type": "string" },
                "secondaryDns": { "type": "string" }
              }
            },
            "ipv6": {
              "type": "object",
              "description": "Default IPv6 address settings",
              "properties": {
                "method": { "type": "string", "enum": ["auto", "dhcp", "static", "disabled"] },
                "address": { "type": "string", "description": "IPv6 address with /prefix notation" },
                "gateway": { "type": "string" },
                "primaryDns": { "type": "string" },
                "secondaryDns": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "onboardingUser": {
      "type": "object",
      "description": "Onboarding user account configuration",
      "properties": {
        "password": {
          "type": "string",
          "default": "",
          "description": "Password for the temporary onboarding user. Empty string means passwordless login (default)."
        }
      }
    },
    "statusHook": {
      "type": "object",
      "description": "Status hook configuration for lifecycle event notifications. The hook executable must be placed in /usr/libexec/flightctl-onboarding/hooks.d/ and is invoked with a state argument (ready, in-progress, applying, success, error, off).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable status hook invocation during onboarding lifecycle transitions"
        },
        "tool": {
          "type": "string",
          "pattern": "^[^/\\.][^/]*$",
          "description": "Filename of the status hook executable in the hooks.d directory (no path separators)"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["tool"]
      }
    }
  },
  "required": ["version"],
  "examples": [
    {
      "version": "1.0",
      "brandName": "Flight Control",
      "runOnce": true,
      "keepCockpit": false,
      "hideModules": true,
      "autoReboot": false,
      "network": {
        "activationTimeoutSeconds": 30,
        "wifiAp": {
          "enabled": true,
          "ssidPrefix": "flightctl-",
          "interface": "",
          "password": "",
          "address": "10.42.0.1",
          "subnetPrefix": 24,
          "dhcpRangeSize": 40,
          "channel": 6,
          "dhcpLeaseDuration": "1h",
          "watchdogTimeoutSeconds": 420,
          "driver": "nl80211",
          "hwMode": "g",
          "scanWaitMs": 3000
        },
        "ethernet": {
          "enabled": true,
          "staticIp": "192.168.100.1",
          "subnetPrefix": 24,
          "dhcpRangeSize": 40,
          "dhcpLeaseDuration": "1h",
          "watchdogTimeoutSeconds": 600
        }
      },
      "flightctl": {
        "defaultEndpoint": "https://api.flightctl.example.com",
        "certificateExpiration": "365d"
      },
      "connectivityTest": {
        "host": "cockpit-project.org",
        "required": true,
        "connectivityTimeoutSeconds": 300,
        "ntpSyncTimeoutSeconds": 30,
        "pingTimeoutSeconds": 10,
        "pingWaitSeconds": 5
      },
      "onboardingUser": {
        "password": ""
      },
      "statusHook": {
        "enabled": false,
        "tool": "my-status-handler"
      }
    }
  ]
}
