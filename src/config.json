{
  "version": "1.0",
  "runOnce": true,
  "keepCockpit": false,
  "hideModules": true,
  "autoReboot": false,
  "network": {
    "activationTimeoutSeconds": 30,
    "wifiAp": {
      "enabled": true,
      "ssidPrefix": "flightctl-",
      "interface": "",
      "password": "onboarding",
      "address": "10.42.0.1",
      "subnetPrefix": 24,
      "dhcpRangeSize": 40,
      "channel": 6,
      "dhcpLeaseDuration": "1h",
      "watchdogTimeoutSeconds": 420,
      "driver": "nl80211",
      "hwMode": "g",
      "scanWaitMs": 3000
    },
    "ethernet": {
      "enabled": true,
      "staticIp": "192.168.100.1",
      "subnetPrefix": 24,
      "dhcpRangeSize": 40,
      "dhcpLeaseDuration": "1h",
      "watchdogTimeoutSeconds": 600
    }
  },
  "flightctl": {
    "defaultEndpoint": "",
    "certificateExpiration": "365d"
  },
  "connectivityTest": {
    "host": "cockpit-project.org",
    "required": true,
    "connectivityTimeoutSeconds": 300,
    "ntpSyncTimeoutSeconds": 30,
    "pingTimeoutSeconds": 10,
    "pingWaitSeconds": 5
  },
  "onboardingUser": {
    "password": ""
  },
  "statusHook": {
    "enabled": false
  }
}
