{
  "version": "1.0",
  "runOnce": false,
  "keepCockpit": true,
  "hideModules": true,
  "autoReboot": false,
  "network": {
    "wifiAp": {
      "enabled": false
    },
    "ethernet": {
      "enabled": true,
      "staticIp": "192.168.100.1",
      "subnetPrefix": 24,
      "dhcpRangeSize": 40
    }
  },
  "flightctl": {
    "defaultEndpoint": "https://flightctl.internal"
  },
  "connectivityTest": {
    "host": "flightctl.internal"
  },
  "onboardingUser": {
    "password": ""
  },
  "led": {
    "enabled": false
  }
}
