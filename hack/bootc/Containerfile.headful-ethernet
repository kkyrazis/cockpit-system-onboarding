FROM localhost/onboarding-agent-base:latest

RUN --mount=type=cache,target=/var/cache/libdnf5 \
    dnf install -y \
    cage \
    firefox \
    mesa-dri-drivers \
    mesa-libgbm \
    mesa-libEGL

COPY config/config-ethernet.json /etc/cockpit/system-onboarding/config.json

COPY cockpit-system-onboarding-*.noarch.rpm /tmp/
RUN --mount=type=cache,target=/var/cache/libdnf5 \
    dnf install -y /tmp/cockpit-system-onboarding-*.noarch.rpm \
    && rm -f /tmp/*.rpm

RUN systemctl enable cockpit-system-onboarding-setup.service

COPY config/cage-kiosk@.service /etc/systemd/system/cage-kiosk@.service
COPY config/cage-pam /etc/pam.d/cage
RUN useradd -m -s /bin/bash kiosk \
    && systemctl enable cage-kiosk@tty7.service \
    && systemctl set-default graphical.target
